APP_NAME="Shop Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.mydomain.test:8000
# A store cannot take orders until its owner verifies their email (true by default).
REQUIRE_VERIFIED_EMAIL_TO_SELL=true
FRONTEND_URL=http://app.mydomain.test:3000
PLATFORM_DOMAIN=mydomain.test
CUSTOM_DOMAIN_CNAME_TARGET=shops.mydomain.test

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shop_platform
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=10080

# IP(s) of the Next.js storefront server (comma separated) or * if behind a trusted edge
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://app.mydomain.test:3000
CORS_ALLOWED_ORIGINS_PATTERNS=#^https?://[a-z0-9-]+\.mydomain\.test(:\d+)?$#

# Local development: Mailpit (docker compose up -d mailpit) catches everything at http://localhost:8025.
# Production: use a real provider (smtp, ses, postmark, resend...) with a verified sender domain.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mydomain.test"
MAIL_FROM_NAME="${APP_NAME}"

SEED_ADMIN_EMAIL=admin@mydomain.test
DEFAULT_PLAN_SLUG=free

# OpenAPI docs at /docs/api: always on locally; set true to publish in production
API_DOCS_ENABLED=false
SEED_ADMIN_PASSWORD=

# Phase 2+
MEDIA_DRIVER=cloudinary
MEDIA_MAX_UPLOAD_KB=5120
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_CDN_URL=
CUSTOM_DOMAIN_IPS=
CUSTOM_DOMAIN_MAX=3
# Stores normally add their own keys in the dashboard. These are used only when enabled:
PAYMENTS_USE_PLATFORM_CREDENTIALS=false
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
UNPAID_ORDER_EXPIRY_HOURS=24
STOREFRONT_SCHEME=https

# Monitoring (see config/monitoring.php). Slow queries/requests are logged as warnings; failed jobs as errors.
MONITOR_SLOW_QUERY_MS=500
MONITOR_SLOW_REQUEST_MS=2000
# Email this address when a queued job fails (at most once per job type every 15 minutes). Empty = log only.
MONITOR_ALERT_EMAIL=
# Probe GET /api/v1/health (database, cache, scheduler, queue worker). If set, send it as the X-Health-Token header.
MONITOR_HEALTH_TOKEN=

# Days to keep audit log entries (0 = keep forever). Only platform admins can read them.
AUDIT_RETENTION_DAYS=730
