# Production environment for compose.prod.yaml. Copy to .env.production and replace every CHANGE_ME.
# NEVER commit the real file.

APP_NAME="Shop Platform"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose --env-file .env.production -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_URL=https://api.mydomain.com
FRONTEND_URL=https://app.mydomain.com
PLATFORM_DOMAIN=mydomain.com
CUSTOM_DOMAIN_CNAME_TARGET=shops.mydomain.com
STOREFRONT_SCHEME=https

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=CHANGE_ME

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
# Memory Redis may use before it starts evicting cache and sessions (queued jobs are never evicted)
REDIS_MAXMEMORY=512mb

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Sanctum bearer tokens expire after this many minutes (default 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

# IP(s) of the Next.js server that calls this API (comma separated), or * if only a trusted edge can reach it.
TRUSTED_PROXIES=CHANGE_ME
CORS_ALLOWED_ORIGINS=https://app.mydomain.com
CORS_ALLOWED_ORIGINS_PATTERNS=#^https://[a-z0-9-]+\.mydomain\.com$#

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@mydomain.com"
MAIL_FROM_NAME="Shop Platform"

# Media: cloudinary or spaces (DigitalOcean Spaces)
# Provider for NEW uploads: cloudinary or spaces. To move existing images later: php artisan media:migrate cloudinary spaces
MEDIA_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_CDN_URL=

# Stores bring their own Paystack/Flutterwave keys. Only set these for a platform-managed account.
PAYMENTS_USE_PLATFORM_CREDENTIALS=false
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
UNPAID_ORDER_EXPIRY_HOURS=24

# Public OpenAPI docs at /docs/api (always on locally; off in production unless true)
API_DOCS_ENABLED=false
DEFAULT_PLAN_SLUG=free

# Used by `php artisan db:seed` in production (platform admin only; demo data is never seeded in production)
SEED_ADMIN_EMAIL=admin@mydomain.com
SEED_ADMIN_PASSWORD=

# Monitoring (see config/monitoring.php). Slow queries/requests are logged as warnings; failed jobs as errors.
MONITOR_SLOW_QUERY_MS=500
MONITOR_SLOW_REQUEST_MS=2000
# Email this address when a queued job fails (at most once per job type every 15 minutes). Empty = log only.
MONITOR_ALERT_EMAIL=
# Probe GET /api/v1/health (database, cache, scheduler, queue worker). If set, send it as the X-Health-Token header.
MONITOR_HEALTH_TOKEN=

# Days to keep audit log entries (0 = keep forever). Only platform admins can read them.
AUDIT_RETENTION_DAYS=730
